generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id        String   @id @db.VarChar(255)
  name      String   @db.VarChar(255)
  email     String   @unique @db.VarChar(255)
  image     String?  @db.Text
  wishlist  Json?
  createdAt DateTime @default(now())
}
